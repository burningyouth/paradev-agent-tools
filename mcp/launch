#!/bin/sh
set -eu

usage() {
  cat <<'HELP'
Paradev Agent Tools

Откройте launch в терминале и выберите клиент или выполните одну из команд.

  ./paradev-agent-tools/launch --install codex
  ./paradev-agent-tools/launch --install opencode-auto
  ./paradev-agent-tools/launch --install opencode-paradev --workspace /path/to/worktree
  ./paradev-agent-tools/launch --install kilo

ZIP впервые подключается через sh Install.sh. Для проверки обновления: launch --agent-cli update check.
В старом TAR Codex и OpenCode 2 подключаются через Git. Для локального режима TAR добавьте --local.
В клоне ветки distribution добавьте --link к установке kilo, opencode-v1 или manual.
Для других MCP-клиентов укажите абсолютный путь к launch как локальную команду stdio.
Для диагностики выполните ./paradev-agent-tools/launch --diagnose.
HELP
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  '') if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then set -- --install; fi ;;
esac

root=$(CDPATH= cd -- "$(PATH=/usr/bin:/bin dirname -- "$0")" && pwd)
case "$(PATH=/usr/bin:/bin uname -s):$(PATH=/usr/bin:/bin uname -m)" in
  Darwin:arm64) platform=darwin-arm64 ;;
  Darwin:x86_64) platform=darwin-amd64 ;;
  Linux:aarch64|Linux:arm64) platform=linux-arm64 ;;
  Linux:x86_64) platform=linux-amd64 ;;
  *) printf '%s\n' "Paradev Agent Tools: нужны macOS или Linux на arm64/amd64." >&2; exit 1 ;;
esac
binary="$root/bin/$platform/paradev-agent"
if [ ! -x "$binary" ]; then
  printf '%s\n' "Paradev Agent Tools: в пакете отсутствует $binary." >&2
  exit 1
fi

export PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.paradev/bin:$HOME/.superset/bin:$HOME/superset/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export AGENT_CLI_LAUNCHER="${AGENT_CLI_MANAGED_LAUNCHER:-$root/launch}"
unset AGENT_CLI_MANAGED_LAUNCHER
case "${1:-}" in
  --install) shift; exec "$binary" install-client "$@" ;;
  --agent-cli) shift; exec "$binary" "$@" ;;
  --diagnose) exec "$binary" diagnose --json ;;
  *) exec "$binary" mcp ;;
esac
